{
  "name": "OrganisationsAI - Intelligentes Dokumentenverwaltungssystem",
  "short_name": "OrganisationsAI",
  "description": "Enterprise-class document management with AI-powered categorization, OCR, and advanced search",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#5B4BF2",
  "background_color": "#FFFFFF",
  
  "icons": [
    {
      "src": "/app/static/images/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app/static/images/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app/static/images/icon-192x192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/app/static/images/icon-512x512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "categories": ["productivity", "business"],
  "screenshots": [
    {
      "src": "/app/static/images/screenshot-1.png",
      "sizes": "540x720",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "/app/static/images/screenshot-1-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide"
    }
  ],

  "shortcuts": [
    {
      "name": "Dokumente",
      "short_name": "Dokumente",
      "description": "Alle Dokumente anzeigen",
      "url": "/documents",
      "icons": [
        {
          "src": "/app/static/images/icon-shortcut-documents.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Hochladen",
      "short_name": "Hochladen",
      "description": "Neues Dokument hochladen",
      "url": "/upload",
      "icons": [
        {
          "src": "/app/static/images/icon-shortcut-upload.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Suche",
      "short_name": "Suche",
      "description": "Dokumente durchsuchen",
      "url": "/search",
      "icons": [
        {
          "src": "/app/static/images/icon-shortcut-search.png",
          "sizes": "192x192"
        }
      ]
    }
  ],

  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "document",
          "accept": [
            "application/pdf",
            "image/*",
            "application/msword",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
          ]
        }
      ]
    }
  },

  "protocol_handlers": [
    {
      "protocol": "web+organisationsai",
      "url": "/protocol?url=%s"
    }
  ],

  "prefer_related_applications": false,
  
  "related_applications": []
}
