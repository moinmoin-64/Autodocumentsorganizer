{
  "name": "organisationsai",
  "version": "1.0.0",
  "description": "Enterprise-Grade Organization AI Platform with TypeScript",
  "main": "index.js",
  "scripts": {
    "build": "tsc --noEmit && npm run compile",
    "compile": "tsc",
    "watch": "tsc --watch",
    "type-check": "tsc --noEmit",
    "dev": "concurrently \"npm run watch\" \"npm run serve\"",
    "serve": "python -m flask run",
    "test": "pytest tests/ -v",
    "test:ts": "npm run type-check && npm test",
    "test:unit": "pytest tests/unit -v",
    "test:integration": "pytest tests/integration -v",
    "test:e2e": "pytest tests/test_phase5_e2e.py -v",
    "test:load": "python load_test.py",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:load",
    "lint": "eslint app/static/js/*.ts --fix",
    "clean": "rimraf dist/",
    "build:prod": "npm run clean && tsc --sourceMap false && npm run minify",
    "minify": "uglifyjs dist/**/*.js -c -m -o dist/app.min.js",
    "ci": "npm run type-check && npm run test:all",
    "prepare": "npm run build"
  },
  "keywords": [
    "organization",
    "ai",
    "typescript",
    "flask",
    "pwa"
  ],
  "author": "OrganisationsAI Team",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.3.3",
    "concurrently": "^8.2.2",
    "rimraf": "^5.0.5",
    "uglify-js": "^3.17.4",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@types/node": "^20.10.6",
    "@types/web": "^0.0.126"
  },
  "dependencies": {
    "axios": "^1.6.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0",
    "python": ">=3.10"
  }
}
